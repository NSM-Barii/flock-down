<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <org.osmdroid.views.MapView
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top-right HUD -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvSpeed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-- mph"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:background="#AA000000"
            android:padding="8dp" />

        <TextView
            android:id="@+id/tvNearest"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No cameras nearby"
            android:textColor="#FFDD00"
            android:textSize="14sp"
            android:background="#AA000000"
            android:padding="6dp"
            android:layout_marginTop="4dp" />

        <!-- Counter -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#AA000000"
            android:padding="6dp"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvSessionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SESSION"
                android:textColor="#AAAAAA"
                android:textSize="11sp"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/tvSession"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#FF4444"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginEnd="12dp" />

            <TextView
                android:id="@+id/tvTotalLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TOTAL"
                android:textColor="#AAAAAA"
                android:textSize="11sp"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/tvTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#FF4444"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Flock-only toggle button -->
        <Button
            android:id="@+id/switchFlockOnly"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ALL CAMERAS"
            android:textSize="12sp"
            android:textStyle="bold"
            android:backgroundTint="#AA000000"
            android:textColor="#AAAAAA"
            android:layout_marginTop="4dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp" />

    </LinearLayout>

    <!-- Bottom-left nav buttons -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:orientation="horizontal"
        android:padding="12dp">

        <Button
            android:id="@+id/btnLog"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LOG"
            android:textSize="12sp"
            android:backgroundTint="#AA000000"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnSettings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SETTINGS"
            android:textSize="12sp"
            android:backgroundTint="#AA000000"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnRecenter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⊙ ME"
            android:textSize="12sp"
            android:backgroundTint="#AA000000"
            android:textColor="#00CCFF"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnCache"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CACHE"
            android:textSize="12sp"
            android:backgroundTint="#AA000000"
            android:textColor="#00FF88" />

    </LinearLayout>

    <!-- Full-screen Flock alert overlay -->
    <LinearLayout
        android:id="@+id/layoutFlockAlert"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#DD000000"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FLOCK SAFETY"
            android:textColor="#FF0000"
            android:textSize="48sp"
            android:textStyle="bold"
            android:letterSpacing="0.15" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LICENSE PLATE READER"
            android:textColor="#FF6666"
            android:textSize="22sp"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/tvFlockDist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#FFFFFF"
            android:textSize="36sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

    </LinearLayout>

    <!-- Generic ALPR bottom banner -->
    <TextView
        android:id="@+id/tvAlert"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:text=""
        android:textColor="#FFDD00"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:background="#CC222200"
        android:padding="10dp"
        android:visibility="gone" />

</FrameLayout>
